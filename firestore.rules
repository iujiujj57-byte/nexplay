rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "arehq@schools.vic.edu.au"
        && request.auth.token.email_verified == true;
    }
    match /profiles/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 20;
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /bannedUsers/{userId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow list, create, update, delete: if isAdmin();
    }
  }
}
